VITE_BASE=/

# 接口地址 - 使用相对路径，由 Nginx 反向代理
VITE_GLOB_API_URL=/api/v1

# 是否开启压缩，可以设置为 none, brotli, gzip
VITE_COMPRESS=gzip

# 是否开启 PWA
VITE_PWA=false

# vue-router 的模式 (history 模式 URL 更简洁，适合分享链接)
VITE_ROUTER_HISTORY=

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 打包后是否生成dist.zip
VITE_ARCHIVER=false
