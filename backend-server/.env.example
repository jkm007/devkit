# 后端服务环境变量配置示例
# 复制此文件为 .env 并填入真实值
# 环境变量会覆盖 config.yaml 中的对应配置

# MySQL
MYSQL_PASSWORD=your_mysql_password

# Redis
REDIS_PASSWORD=your_redis_password

# JWT（建议使用 64 字节以上的随机字符串）
JWT_SECRET=your_jwt_secret_key_at_least_64_bytes_random

# AES-256 加密密钥（必须 32 字节）
AES_KEY=your_aes_key_exactly_32_bytes!

# 验证码加密密钥（建议 32 字节）
CAPTCHA_SECRET=your_captcha_secret_key_32bytes!
